# ============ 本地运行必需 ============
# 在 https://tushare.pro/user/token 复制你的 token
TUSHARE_TOKEN=your_token_here

# ============ DeepSeek AI 解读（可选） ============
# 在 https://platform.deepseek.com 获取你的 DeepSeek API Key，不填则跳过 AI 解读
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
